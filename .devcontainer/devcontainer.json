{
  "name": "C Crashkurs",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.makefile-tools"
      ],
      "settings": {
        "C_Cpp.default.cStandard": "c17",
        "editor.formatOnSave": true
      }
    }
  },
  "remoteUser": "vscode"
}
