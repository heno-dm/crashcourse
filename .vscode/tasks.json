{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: aktuelle Datei bauen",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-std=c23",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-Wconversion",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}